# Copiá este archivo a .env y completá los valores. El .env NUNCA se sube al repo.

# Base de datos. Para la contraseña usá solo letras y números, por ejemplo: openssl rand -hex 24
POSTGRES_USER=vb
POSTGRES_PASSWORD=
POSTGRES_DB=vb

# Opcional: Cloudflare Turnstile (anti-spam). Si se deja vacío, no se exige.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcional: aviso por Telegram de cada aplicación nueva. Si se deja vacío, no se envía.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: enviar cada aplicación a otro sistema (webhook). Si WEBHOOK_URL está vacío, no se envía.
# Si el otro sistema corre en Docker en este servidor, usá el nombre de su contenedor y puerto interno,
# por ejemplo http://mi-sistema:8080/webhooks/vb
WEBHOOK_URL=
# Secreto compartido para firmar los envíos (mínimo 32 caracteres): openssl rand -hex 32
WEBHOOK_SECRET=
# Red de Docker donde está el otro sistema (docker network ls). Por defecto, la de Nginx Proxy Manager.
WEBHOOK_NETWORK=mi-red-nginx
